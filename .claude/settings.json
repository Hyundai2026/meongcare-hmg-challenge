{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "skillOverrides": {
    "bmad-build": "off",
    "bmad-build-auto": "off",
    "bmad-agent-dev": "off",
    "bmad-code-review": "off",
    "bmad-create-epics-and-stories": "off",
    "bmad-sprint-planning": "off",
    "bmad-correct-course": "off",
    "bmad-retrospective": "off",
    "bmad-qa-generate-e2e-tests": "off",
    "bmad-walkthrough": "off",
    "bmad-project-context": "off",
    "bmad-customize": "user-invocable-only"
  },
  "permissions": {
    "allow": [
      "Bash(./gradlew *)",
      "Bash(gradlew.bat *)",
      "Bash(sh gradlew *)",
      "Bash(adb *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "PowerShell(.\\gradlew.bat *)",
      "PowerShell(adb *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git switch *)",
      "WebFetch(domain:document.pleos.ai)",
      "WebFetch(domain:pleos.ai)",
      "WebFetch(domain:appdevchallenge.auto-hmg.io)",
      "WebFetch(domain:developer.android.com)"
    ],
    "ask": [
      "Bash(git push *)",
      "PowerShell(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)"
    ],
    "deny": [
      "Read(**/secrets.properties)",
      "Read(**/keystore.properties)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Edit(**/*.jks)",
      "Edit(**/*.keystore)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.mjs"],
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/build-gate.mjs", "snapshot"],
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/build-gate.mjs", "precommit"],
            "timeout": 600
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/build-gate.mjs", "stop"],
            "timeout": 600
          }
        ]
      }
    ]
  }
}

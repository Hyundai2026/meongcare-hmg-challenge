{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./gradlew *)",
      "Bash(gradlew.bat *)",
      "Bash(sh gradlew *)",
      "Bash(adb *)",
      "PowerShell(.\\gradlew.bat *)",
      "PowerShell(adb *)",
      "WebFetch(domain:document.pleos.ai)",
      "WebFetch(domain:pleos.ai)",
      "WebFetch(domain:appdevchallenge.auto-hmg.io)",
      "WebFetch(domain:developer.android.com)"
    ],
    "deny": [
      "Read(**/secrets.properties)",
      "Read(**/keystore.properties)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Edit(**/*.jks)",
      "Edit(**/*.keystore)",
      "Bash(git push --force *)",
      "Bash(git push -f *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.mjs"],
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/build-gate.mjs", "snapshot"],
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/build-gate.mjs", "precommit"],
            "timeout": 600
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/build-gate.mjs", "stop"],
            "timeout": 600
          }
        ]
      }
    ]
  }
}

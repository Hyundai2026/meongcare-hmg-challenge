<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- pleos.car.permission.* 권한은 사용자 승인 없이 추가하지 않는다 (AGENTS.md 규칙 2). -->

    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />

    <!-- 제휴 병원 목록·진료 카드 전송 (012, Firebase). 일반(normal) 권한이라 실행 중 묻지 않는다. Pleos 권한이 아니다. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 내비가 없는 기기(일반 폰·태블릿)에서 근처 동물병원을 지금 위치로 찾는다 (계획 015, 사용자 결정 2026-11-08).
         차량 기기는 Pleos 내비 위치를 쓰고 이 권한을 묻지 않는다. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:name=".MeongCareApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MeongCare">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
                주행 중 사용(DO, Distraction Optimized) 선언. 없으면 주행 중에 시스템 화면
                ("주행 중에는 사용할 수 없습니다.")이 이 Activity를 가린다.
                - 방식: AAOS Google 가이드 그대로 (docs/pleos/ux-guidelines.md "DO 미선언 앱").
                - Pleos 에뮬레이터에서 동작을 확인했다 (2026-11-05). 실차·앱 심사 허용 여부는
                  주최측 문의 B1 답을 기다린다. 안 된다고 하면 이 선언을 넣은 커밋을 revert한다.
                - 선언했으므로 주행 중 안전은 앱이 책임진다: 주행 규제가 걸리면 주행 화면만 보여 준다
                  (입력·스크롤·애니메이션 없음, AGENTS.md 규칙 3).
            -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>
    </application>

</manifest>

rules_version = '2';

// MeongCare 제휴 병원·환자 건 보안 규칙 (계획 012 "설계 결정 6"), 보호자 프로필·차 연결 (계획 014).
// 형식: docs/data/hospital-status.md, docs/data/emergency-case.md, docs/data/owner-link.md
// 차와 병원 웹 모두 익명 로그인한다. "로그인했는가"만이 아니라 "누구의 문서인가"로 막는다.
// 점검: npm --prefix firebase run check-rules (R1~R24)
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isStaff(hid) {
      return signedIn()
        && exists(/databases/$(database)/documents/hospitals/$(hid)/staff/$(request.auth.uid));
    }

    function validStatus(s) {
      return s is map
        && s.keys().hasOnly(['waitMinutes', 'congestion', 'acceptingEmergency', 'updatedAt'])
        && s.keys().hasAll(['waitMinutes', 'congestion', 'acceptingEmergency', 'updatedAt'])
        && s.waitMinutes is int && s.waitMinutes >= 0 && s.waitMinutes <= 600
        && s.congestion in ['low', 'normal', 'high']
        && s.acceptingEmergency is bool
        && s.updatedAt == request.time;
    }

    function optionalNullOr(d, key, type) {
      return !(key in d) || d[key] == null
        || (type == 'int' && d[key] is int)
        || (type == 'timestamp' && d[key] is timestamp);
    }

    // 차가 만드는 환자 건. 사진(photoDataUrl)과 차 위치는 받지 않는다.
    function validNewCase(d) {
      return d.keys().hasOnly(['schemaVersion', 'createdBy', 'createdAt', 'status', 'remainingMinutes',
                               'etaAt', 'etaUpdatedAt', 'card', 'acknowledgedAt'])
        && d.keys().hasAll(['schemaVersion', 'createdBy', 'createdAt', 'status', 'card'])
        && d.schemaVersion == 1
        && d.createdBy == request.auth.uid
        && d.createdAt is timestamp
        && d.status == 'en_route'
        && optionalNullOr(d, 'remainingMinutes', 'int')
        && optionalNullOr(d, 'etaAt', 'timestamp')
        && optionalNullOr(d, 'etaUpdatedAt', 'timestamp')
        && (!('acknowledgedAt' in d) || d.acknowledgedAt == null)
        && d.card is map
        && d.card.keys().hasOnly(['pet', 'symptoms'])
        && d.card.symptoms is list && d.card.symptoms.size() <= 12
        && (!('pet' in d.card) || d.card.pet == null
            || (d.card.pet is map && !('photoDataUrl' in d.card.pet)));
    }

    match /hospitals/{hid} {
      allow read: if signedIn();
      // 병원 문서는 시드(관리자)만 만든다. 직원은 status만 바꾼다.
      allow create, delete: if false;
      allow update: if isStaff(hid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && validStatus(request.resource.data.status);

      // 병원 코드가 맞는 브라우저(익명 계정)를 그 병원 직원으로 등록한다.
      match /staff/{uid} {
        allow create: if signedIn() && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['joinCode'])
          && request.resource.data.joinCode is string
          && request.resource.data.joinCode
             == get(/databases/$(database)/documents/hospitalSecrets/$(hid)).data.joinCode;
        allow read: if signedIn() && uid == request.auth.uid;
        allow update, delete: if false;
      }

      match /cases/{cid} {
        allow create: if signedIn()
          && exists(/databases/$(database)/documents/hospitals/$(hid))
          && validNewCase(request.resource.data);
        allow read: if signedIn() && (resource.data.createdBy == request.auth.uid || isStaff(hid));
        allow update: if signedIn() && (
          (resource.data.createdBy == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'remainingMinutes', 'etaAt', 'etaUpdatedAt'])
            && request.resource.data.status in ['en_route', 'arrived', 'cancelled']
            && optionalNullOr(request.resource.data, 'remainingMinutes', 'int')
            && optionalNullOr(request.resource.data, 'etaAt', 'timestamp'))
          // 병원 [카드 확인] (계획 013): 서버 시각으로, 확인 전인 건에 한 번만
          || (isStaff(hid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acknowledgedAt'])
            && (!('acknowledgedAt' in resource.data) || resource.data.acknowledgedAt == null)
            && request.resource.data.acknowledgedAt == request.time));
        // [완료]는 병원이 지운다. 보낸 차도 자기 건은 지울 수 있다.
        allow delete: if isStaff(hid) || (signedIn() && resource.data.createdBy == request.auth.uid);
      }
    }

    // 병원별 시연 코드. 아무도 읽거나 쓰지 못한다 (규칙의 get()만 읽는다).
    match /hospitalSecrets/{hid} {
      allow read, write: if false;
    }

    // ---- 보호자 프로필과 차 연결 (계획 014). 형식: docs/data/owner-link.md ----
    // 보호자와 차 모두 익명 계정이다. 차는 연결된 보호자의 프로필 문서 하나만 읽고, 아무것도 쓰지 못한다.

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function nullOr(v, type) {
      return v == null || (type == 'string' && v is string) || (type == 'bool' && v is bool);
    }

    // pet-profile v1 (docs/data/pet-profile.md). 사진은 따로 둔다 (photoDataUrl은 늘 null).
    // 글자 수 20자는 쓰는 쪽(웹 폼)이 코드 포인트로 지킨다. 규칙은 이모지 등을 고려해 넉넉히 본다.
    function validProfile(d) {
      return d.keys().hasOnly(['schemaVersion', 'name', 'breed', 'sex', 'birthDate', 'birthDateIsEstimated',
                               'photoDataUrl', 'medical', 'updatedAt'])
        && d.keys().hasAll(['schemaVersion', 'name', 'breed', 'sex', 'birthDate', 'birthDateIsEstimated',
                            'photoDataUrl', 'medical', 'updatedAt'])
        && d.schemaVersion == 1
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 40
        && nullOr(d.breed, 'string')
        && (d.sex == null || d.sex in ['male', 'female'])
        && nullOr(d.birthDate, 'string')
        && d.birthDateIsEstimated is bool
        && d.photoDataUrl == null
        && d.medical is map
        && d.medical.keys().hasOnly(['conditions', 'allergies', 'medications'])
        && d.medical.conditions is list && d.medical.conditions.size() <= 20
        && d.medical.allergies is list && d.medical.allergies.size() <= 20
        && d.medical.medications is list && d.medical.medications.size() <= 20
        && d.updatedAt is string;
    }

    // 연결 코드 유효 시간. 차 앱(LinkCode.VALIDITY)과 같다
    function codeAlive(c) {
      return request.time < c.createdAt + duration.value(10, 'm');
    }

    // 서버 저장 동의. 동의 문서가 있어야 프로필을 만든다
    match /owners/{uid} {
      allow get, delete: if isSelf(uid);
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['schemaVersion', 'consentVersion', 'consentedAt'])
        && request.resource.data.keys().hasAll(['schemaVersion', 'consentVersion', 'consentedAt'])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.consentVersion == 1
        && request.resource.data.consentedAt == request.time;
    }

    match /petProfiles/{uid} {
      // 연결된 차는 허가 문서(readers/{차 uid})가 있으면 읽는다. resource를 보지 않아서, 프로필이 없으면 404다 (403은 연결 끊김)
      allow get: if isSelf(uid)
        || (signedIn() && exists(/databases/$(database)/documents/petProfiles/$(uid)/readers/$(request.auth.uid)));
      allow create, update: if isSelf(uid)
        && exists(/databases/$(database)/documents/owners/$(uid))
        && validProfile(request.resource.data);
      allow delete: if isSelf(uid);

      // 사진: 보호자만 (차는 읽지 못한다)
      match /private/{doc} {
        allow get, delete: if isSelf(uid);
        allow create, update: if isSelf(uid) && doc == 'photo'
          && request.resource.data.keys().hasOnly(['photoDataUrl'])
          && request.resource.data.photoDataUrl is string
          && request.resource.data.photoDataUrl.size() <= 400000
          && request.resource.data.photoDataUrl.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]*');
      }

      // 연결 허가. 보호자가 그 차의 코드를 claim하는 같은 한 번에 쓰기(batch)에서만 만든다 (getAfter)
      match /readers/{carUid} {
        allow create: if isSelf(uid)
          && request.resource.data.keys().hasOnly(['linkCode', 'createdAt'])
          && request.resource.data.keys().hasAll(['linkCode', 'createdAt'])
          && request.resource.data.createdAt == request.time
          && request.resource.data.linkCode is string
          && getAfter(/databases/$(database)/documents/linkCodes/$(request.resource.data.linkCode)).data.ownerUid == uid
          && getAfter(/databases/$(database)/documents/linkCodes/$(request.resource.data.linkCode)).data.carUid == carUid;
        allow get, delete: if isSelf(uid) || isSelf(carUid);
        allow list: if isSelf(uid);
      }
    }

    // 연결 코드. 차가 만들고, 보호자가 한 번만 claim한다. 목록 조회는 막는다 (get만)
    match /linkCodes/{code} {
      allow create: if signedIn()
        && code.matches('[2-9A-HJKMNP-Z]{6}')
        && request.resource.data.keys().hasOnly(['schemaVersion', 'carUid', 'createdAt', 'ownerUid', 'claimedAt'])
        && request.resource.data.keys().hasAll(['schemaVersion', 'carUid', 'createdAt', 'ownerUid', 'claimedAt'])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.carUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.ownerUid == null
        && request.resource.data.claimedAt == null;
      allow get: if signedIn() && (
        resource.data.carUid == request.auth.uid
        || resource.data.ownerUid == request.auth.uid
        || (resource.data.ownerUid == null && codeAlive(resource.data)));
      allow update: if signedIn()
        && resource.data.ownerUid == null
        && codeAlive(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerUid', 'claimedAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.claimedAt == request.time;
      allow delete: if signedIn() && resource.data.carUid == request.auth.uid;
    }
  }
}

# 이 파일을 복사해 secrets.properties로 만들고 값을 채운다. (secrets.properties는 커밋 금지)
# Pleos Playground 콘솔 > 프로젝트 > SDK 섹션에서 발급 (TTS/STT용)
PLEOS_CLIENT_ID=
PLEOS_CLIENT_SECRET=

# Firebase (계획 012: 제휴 병원 목록·진료 카드 전송). 비우면 앱은 내장 시연 병원으로 돈다.
# 로컬 에뮬레이터(firebase/README.md)에 붙일 때 (debug 빌드만):
#   FIREBASE_PROJECT_ID=demo-meongcare
#   FIREBASE_API_KEY=demo-key
#   FIREBASE_EMULATOR_HOST=10.0.2.2   (Android 에뮬레이터에서 본 PC 주소. 안 되면 127.0.0.1 + adb reverse)
# 진짜 프로젝트: 콘솔의 프로젝트 ID와 웹 API 키, EMULATOR_HOST는 비운다.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_EMULATOR_HOST=

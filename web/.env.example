# 병원 웹을 Firebase에 연결할 때 web/.env.local로 복사해서 채운다 (.env.local은 커밋하지 않는다).
# 비어 있으면 병원 웹은 메모리 모드(서버 없이 이 브라우저에서만)로 돈다.
# VITE_로 시작하는 값은 빌드 결과(번들)에 그대로 들어가 공개된다.

# 로컬 에뮬레이터 (firebase/README.md): 아래 세 줄 그대로
VITE_FIREBASE_PROJECT_ID=demo-meongcare
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1

# 진짜 프로젝트: 콘솔 → 프로젝트 설정 → 내 앱(웹)의 firebaseConfig 값. EMULATOR_HOST는 비운다
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_EMULATOR_HOST=
